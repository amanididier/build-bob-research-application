{
  "name": "@bob/desktop",
  "version": "1.0.18",
  "description": "Bob desktop research companion",
  "author": "Bob",
  "private": true,
  "main": "main.cjs",
  "repository": {
    "type": "git",
    "url": "https://github.com/amanididier/build-bob-research-application.git"
  },
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --dir",
    "package": "electron-builder"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "electron": "44.4.3",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.bob.research",
    "productName": "Bob Research Companion",
    "executableName": "bob-research-companion",
    "icon": "icon.ico",
    "publish": {
      "provider": "github",
      "owner": "amanididier",
      "repo": "build-bob-research-application"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "icon.ico",
      "icon.png",
      "renderer/**",
      {
        "from": "../../dist",
        "to": "dist",
        "filter": [
          "**/*"
        ]
      },
      "../../dist/**"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "icon.ico",
      "artifactName": "Bob-Research-Companion-Setup.exe"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "icon.png"
    },
    "linux": {
      "target": "AppImage",
      "category": "Office",
      "icon": "icon.png"
    }
  }
}
